# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3005

# Database Configuration
# MongoDB Connection String (for audit logs & event history)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vasooli?retryWrites=true&w=majority

# SQLite / PostgreSQL Connection URL (for relational models)
DATABASE_URL="file:./dev.db"

# Redis Connection URL (for BullMQ queues)
REDIS_URL=redis://127.0.0.1:6379

# Authentication & JWT
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Integration & Webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Engines (Gemini / Groq)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
